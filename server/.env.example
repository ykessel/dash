NODE_ENV=development
PORT=3000
# App traffic: Neon "-pooler" host in prod. Local: docker compose (port 5434).
DATABASE_URL=postgres://pane:pane@localhost:5434/pane
# Migrations: Neon direct host (no pooler).
DATABASE_URL_DIRECT=postgres://pane:pane@localhost:5434/pane
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Pane <no-reply@pane.local>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_SECURE=false
# Production refuses to boot unless COOKIE_SECURE=true, APP_URL/API_URL are https and JWT_SECRET is not the value above.
# Optional services (unset = off):
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# REDIS_URL=redis://localhost:6380   # needed with more than one instance
# WEB_DIR=../dist                    # serve the built web app at /
# LOG_LEVEL=info                     # fatal|error|warn|info|debug|trace|silent

NODE_ENV=development
PORT=3000
# App traffic: Neon "-pooler" host in prod. Local: docker compose (port 5434).
DATABASE_URL=postgres://pane:pane@localhost:5434/pane
# Migrations: Neon direct host (no pooler).
DATABASE_URL_DIRECT=postgres://pane:pane@localhost:5434/pane
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Pane <no-reply@pane.local>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_SECURE=false

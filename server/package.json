{
  "name": "@pane/server",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "db:up": "docker compose up -d",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "demo:seed": "node scripts/demo-seed.mjs"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.8",
    "@sentry/nestjs": "^11.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
